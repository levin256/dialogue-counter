{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": ["**", "!pnpm-lock.yaml"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "tailwind": {
    "stylesheet": "src/app/index.css"
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": "warn",
        "noUnusedVariables": "warn"
      },
      "style": {
        "useComponentExportOnlyModules": {
          "level": "warn",
          "options": {
            "allowConstantExport": true
          }
        }
      },
      "nursery": {
        "useTailwindSortedClasses": {
          "level": "error",
          "fix": "safe"
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.browser.test.tsx"],
      "linter": {
        "rules": {
          "style": {
            "useComponentExportOnlyModules": "off"
          }
        }
      }
    },
    {
      "includes": ["src/**"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "error"
          }
        }
      }
    },
    {
      "includes": ["src/pages/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/app/**", "../app/**"],
                    "message": "pages は app を読めない。"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/*/components/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/app/**", "@/pages/**"],
                    "message": "features は app・pages を読めない。"
                  },
                  {
                    "group": ["@/features/**", "../../**"],
                    "message": "同じ機能の中は相対パスで読む。ほかの機能は読めない。"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/*/stores/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/app/**", "@/pages/**", "@/shared/ui/**"],
                    "message": "stores は app・pages・画面の部品を読めない。"
                  },
                  {
                    "group": ["../components/**"],
                    "message": "stores は同じ機能の components を読めない（内側は外側を知らない）。"
                  },
                  {
                    "group": ["@/features/**", "../../**"],
                    "message": "同じ機能の中は相対パスで読む。ほかの機能は読めない。"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/*/domain/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**",
                      "!zod/mini",
                      "!vitest",
                      "!./*",
                      "!@/shared/lib/**"
                    ],
                    "message": "domain は zod/mini（テストでは vitest）と、同じフォルダのファイル、純粋な部品（@/shared/lib）だけを読める。"
                  },
                  {
                    "group": ["**/../**"],
                    "message": "パスに .. を書かない。@/shared/lib/../browser のように、許可したフォルダの外に出られるため。"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/shared/lib/**", "src/features/*/domain/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "window": "純粋な部品は window に触らない。ブラウザに触る部品は shared/browser に置く。",
                  "document": "純粋な部品は document に触らない。ブラウザに触る部品は shared/browser に置く。",
                  "navigator": "純粋な部品は navigator に触らない。ブラウザに触る部品は shared/browser に置く。",
                  "location": "純粋な部品は location に触らない。ブラウザに触る部品は shared/browser に置く。",
                  "localStorage": "純粋な部品は localStorage に触らない。ブラウザに触る部品は shared/browser に置く。",
                  "sessionStorage": "純粋な部品は sessionStorage に触らない。ブラウザに触る部品は shared/browser に置く。",
                  "matchMedia": "純粋な部品は matchMedia に触らない。ブラウザに触る部品は shared/browser に置く。"
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/shared/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/app/**", "@/pages/**", "@/features/**"],
                    "message": "汎用のものは app・pages・features を読めない。"
                  },
                  {
                    "group": ["../**"],
                    "message": "フォルダの外は @/ で読む。"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/shared/lib/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/app/**", "@/pages/**", "@/features/**"],
                    "message": "汎用のものは app・pages・features を読めない。"
                  },
                  {
                    "group": ["../**"],
                    "message": "フォルダの外は @/ で読む。"
                  },
                  {
                    "group": [
                      "@/shared/browser/**",
                      "@/shared/hooks/**",
                      "@/shared/ui/**",
                      "**/../**"
                    ],
                    "message": "lib は純粋な部品の置き場なので、browser・hooks・ui を読めない。lib を通して、domain から読めてしまうため。"
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
